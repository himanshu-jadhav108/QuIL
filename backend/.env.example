# ==============================================================================
# Quantum Intelligence Learning Lab — Environment Configuration
# ==============================================================================
# NOTE: All core features (Qiskit Aer simulator, misconception diagnosis,
# deterministic comparison, challenges, and mastery) run 100% locally with
# ZERO API keys required.
# ==============================================================================

# Optional: Google Gemini API Key for live AI Tutor answers
# If omitted, the platform uses its built-in deterministic pedagogical engine.
# GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: Allowed CORS Origins (Comma-separated list of origins, or * for all)
# By default, all origins are permitted so your Vercel frontend connects out of the box.
# CORS_ORIGINS=https://eureka-forge-quantum.vercel.app,http://localhost:3000

# Optional: Frontend URL for documentation and links
# FRONTEND_URL=https://eureka-forge-quantum.vercel.app
